    <string name="state_space_starting">Starting the Space…</string>
    <string name="state_space_failed">The Space could not start on this headset.</string>

    <!-- Strings that carry a value. Kept as format resources so the value's place in the sentence
         is the translator's to choose, not the code's. -->
