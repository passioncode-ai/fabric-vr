         telling the person to re-enter a key that is fine would be the wrong sentence. C-04. -->
    <string name="settings_key_unreadable_now">The saved speech service key could not be read just now. It is still stored — try again in a moment.</string>
    <string name="settings_model_present">%1$s is on this headset</string>
    <string name="settings_model_absent">%1$s is not downloaded</string>
