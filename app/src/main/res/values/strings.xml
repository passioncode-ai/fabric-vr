    <string name="settings_models_total">%1$s in %2$d models</string>
    <string name="settings_models_none">No speech model is downloaded yet.</string>
    <!-- true because: SettingsViewModel.freeUpSpace reads KEY_STT_MODEL and passes it as `keep`;
