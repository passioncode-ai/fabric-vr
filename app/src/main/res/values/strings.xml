<?xml version="1.0" encoding="utf-8"?>
<!--
  Every word the person reads, in one file. Kotlin holds none of them: a copy pass, the brand voice
  or a translation changes this file and nothing else, and a string that appears on two screens
  cannot drift into two spellings.

  That rule is about LOCATION and it held. `DEC-0045` adds the one about TRUTH, because the rule
  above did not stop the first sentence the product said from being wrong twice: `today_empty`
  promised a hold gesture `DEC-0010` had deleted and a note control that did not exist. It was
  never *unreferenced* — it was rendered, on the first screen, every launch — so no mechanical
  check could have caught it.

    A STRING THAT MAKES A CLAIM ABOUT BEHAVIOUR CARRIES A COMMENT NAMING THE CODE THAT MAKES IT
    TRUE, in the form "true because: <file> <symbol> — <what makes it true>". The example is the
    comment above `action_record`; a comment cannot nest inside this one, which is why this says
    where to look rather than showing the markers.

  Only behaviour-claiming strings. A label like `action_copy` names no behaviour and carries
  nothing; annotating everything is how annotations stop being read. **Changing a file named in
  one of these comments means re-reading the strings that point at it** — that is the whole
  review rule, and it is cheap because the annotated set is small.

  Two mechanical halves hold the rest up. Android lint's `UnusedResources` is an ERROR
  (`app/build.gradle.kts`), so a declared string with no caller fails the build — there is no
  suppression list, and a per-string `tools:ignore` must name the board row that owns it.
  `scripts/check-strings.sh` fails a key declared in two modules, which lint cannot see when both
  copies are referenced.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The name in the Horizon OS app library and in the task switcher. A sideloaded app lands
         under "Unknown sources" there, not in the main grid, so the name is what makes it findable
         at all: it is short, it is the first thing typed into the search field, and it is the same
         word as the repository and the package. -->
    <string name="app_name">Fabric VR</string>

    <!-- The immersive activity, so a task switcher showing both does not show one name twice. -->
    <string name="app_name_space">Fabric VR Space</string>

    <!-- Actions -->
    <string name="action_back">Back</string>
    <string name="action_cancel">Cancel</string>
    <string name="action_save">Save</string>
    <string name="action_delete">Delete</string>
    <!-- `action_try_again` was here, unreferenced, as "the evidence of `B-33`" — the state
         `VoiceState.NothingHeard` offers no action. REQ-061 deletes it: the board row IS the
         evidence, a string is not, and a resource kept alive by a `tools:ignore` is a
         suppression list with one entry. `B-150` closes as "the string is gone"; `B-33`, the
         missing control, stays open and unchanged. -->
    <!-- true because: TodayScreen.kt RecordStatus, the NeedsPermission branch — it opens the
         editor through TodayActions.onNewNote. One key, not two: T-031 briefly added a second
         under a different name, and two spellings of one sentence is exactly what this file's
         header exists to prevent. Wording follows core-common's `action_write_note`, which the
         banner renders for the same intent. -->
    <string name="action_write_instead">Write a note instead</string>
    <string name="action_new_note">New note</string>
    <string name="action_clear_query">Clear the query</string>
    <string name="action_clear">Clear</string>
    <!-- The size is an argument since T-031: hard-coded, "(190 MB)" was wrong for four of the
         five models the person can choose between. -->
    <string name="action_download_model">Download speech model (%1$d MB)</string>
    <string name="action_remove_model">Remove speech model</string>
    <string name="action_save_server">Save server</string>
    <string name="action_retry_vault">Retry the vault</string>

    <!-- Section and screen headings -->
    <string name="label_today_note">Today\'s note</string>
    <string name="label_speech">Speech</string>
    <string name="label_vault">Vault</string>
    <string name="label_recent">Recent</string>
    <string name="label_title">Title</string>
    <string name="label_untitled">(untitled)</string>

