    <string name="settings_models_hint">Models you have tried stay on the headset so switching back costs nothing. Free up space keeps the one you have selected.</string>
    <!-- One row. The size is measured from the filesystem rather than taken from the catalogue,
         because what a person deciding what to delete needs is what it occupies NOW. -->
    <string name="settings_model_row">%1$s · %2$s</string>
    <!-- An interrupted transfer keeps its partial on purpose, so Download costs only what is
         missing (H8) — but those bytes are not a model, and a row that did not say so would
         read as a model that is ready to use. -->
    <string name="settings_model_row_partial">unfinished download</string>
    <string name="settings_model_row_ready">ready</string>
    <!-- Its own word, not `action_remove_model`: that one names the selected model and stands
         under the chips; this one is per row and the row already says which model it is. -->
    <string name="action_remove">Remove</string>
    <string name="action_free_up_space">Free up space</string>
    <!-- true because: InstalledModels.remove returns the bytes measured BEFORE the delete, so
         the number is what was reclaimed rather than a guess. Zero is a legal answer and not a
         failure — a person pressing Remove on something already gone wants the shelf empty. -->
    <string name="state_model_removed">%1$s removed · %2$d MB freed</string>
    <string name="state_space_freed">%1$d MB freed · %2$s kept</string>
    <!-- T-031 / D-05: 190 MB with no ETA, in a headset, is an unbounded wait. Deliberately vague
         — the app measures no bandwidth and an invented minute count would be a number it cannot
         keep. "A few minutes" is the honest shape of what is known. -->
    <string name="voice_download_estimate">A few minutes on Wi-Fi. Text notes work meanwhile.</string>
    <!-- C-17: the sentence a person reads must say what http costs them. The platform flag is
         app-wide because Network Security Config cannot express IP ranges (DEC-0005), so this
         string and the code check are the whole of the disclosure. -->
    <string name="settings_server_hint">https anywhere, or http only to a device on your own network — over http your voice is sent unencrypted, so anyone on that network can hear it.</string>
    <string name="settings_carried_over_server">Your whisper server is in use again. Speech now goes there first — change it above if that is not what you want.</string>
